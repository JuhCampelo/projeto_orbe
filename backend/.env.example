# Copie este arquivo para ".env" (mesma pasta) e preencha. O .env não vai para o Git.

# Chave da API da Anthropic (console.anthropic.com > API Keys). Sem ela, a etapa 3 sai só com a indicação documental, sem texto gerado pela IA.
ANTHROPIC_API_KEY=

# Opcionais
# PORT=3000
# ORBE_ADMIN_TOKEN=uma-senha-longa-para-o-export-csv

# Endereço público usado no QR Code da tela inicial. No Render não precisa: ele usa RENDER_EXTERNAL_URL sozinho.
# Defina aqui para mostrar o QR do site publicado quando abrir o Orbe pelo localhost no estande.
# ORBE_URL_PUBLICA=https://orbe.onrender.com
